# Copier en .env pour surcharger localement (Vite charge .env automatiquement).

# URL de base du backend Spring Boot (docker compose up, voir /backend/poc-backend).
VITE_API_BASE_URL=http://localhost:8080

# false = RealApiAdapter (vrais appels HTTP vers VITE_API_BASE_URL, nécessite le backend).
# true  = MockApiAdapter (données simulées, aucun backend requis — utile pour une démo
#         hors-ligne ou si le backend n'est pas disponible).
VITE_USE_MOCK_API=false
